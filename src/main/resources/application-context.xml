<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <!--Abstract bean allow you to define common properties and configuration
    once and reuse them across multiple bean-->
    
    <bean id="p1" abstract="true">
         
          <property name="companyName" value="TCS" />
          <property name="empId" value="101" />
    
    
    </bean>
    
    
     <bean id="child" class="seekho.spring.model.Child" parent="p1">
       <property name="salary" value="220000"/>
       <property name="age" value="18"/>
     
     </bean>
    

</beans>